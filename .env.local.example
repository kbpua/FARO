# Faro Environment Configuration Example
# Copy this file to .env or server/.env and fill in your credentials

# 1. Foursquare Places API (v3) Key (Recommended — Generous Free Developer Tier)
# Get a free key from: https://location.foursquare.com/developer/
FOURSQUARE_API_KEY=

# 2. Google Places API Key (Optional Alternative)
# Get a key from: https://console.cloud.google.com/apis/credentials
GOOGLE_PLACES_API_KEY=

# 3. Server Port Configuration (Default: 5000)
PORT=5000
